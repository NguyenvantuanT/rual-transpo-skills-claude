# Copy vào <repo app>/.claude/harness.env. Mọi key đều tuỳ chọn.

# Rule muốn tắt cho dự án này, cách nhau bởi dấu cách. Tắt rule = quyết định của team, ghi lý do vào CLAUDE.md.
#   code:   null_assert navigator color_literal raw_button raw_tap raw_progress listview_builder
#           raw_dio hardcoded_text comment gr_import app_branch file_size
#   layer:  layer_models layer_services layer_components
#   model:  model_codegen model_handwritten
#   supabase: supa_in_ui sb_secret sb_view_invoker sb_check_uid_only sb_cors_wildcard
#   khác:   arb_sync caret_version analyze squawk
#   web_ts: ts_any ts_ignore console_log tsc eslint depcruise
#   nextjs: next_img next_internal_a next_old_router next_public_secret next_client_server react_html react_index_key
#   nestjs: nest_any_input nest_new_injectable nest_raw_sql nest_process_env nest_plain_error nest_secret prisma_migration
#   python: py_bare_except py_swallow py_print py_debugger py_type_ignore py_sql_fstring py_secret ruff typecheck
#   go:     go_ignored_err go_panic go_println go_bg_ctx go_sql_concat go_secret gofmt vet golangci
#   godot:  gd_print gd_untyped_var gd_parent_path gd_find_node gd_process_alloc gd_secret gdlint gdformat
#   unity:  unity_find unity_debug_log unity_public_field unity_string_coroutine unity_camera_main unity_secret unity_compile
#   verify: test (chạy test liên quan khi dừng) plan_eval (plan tick hết phải có kết quả evaluator)
#   hook:   skill_hint (nhắc load skill theo path) bash_guard (hỏi trước --no-verify / push --force / reset --hard)
HARNESS_DISABLE=

# Pack bật cho repo này. Để trống = tự detect theo file đánh dấu ở root, thư mục con cấp 1 và apps|packages|services|libs/*.
# Chỉ điền khi detect sai. Root khác root repo: <pack>:<thư mục>, vd "nextjs:apps/web web_ts:apps/web nestjs:apps/api web_ts:apps/api".
HARNESS_PACKS=

# Unity: đường dẫn Unity Editor để Stop hook compile + chạy EditMode test (chậm, để trống = bỏ qua).
HARNESS_UNITY=

# Kiểu model: manual (viết tay fromJson) | generated (@JsonSerializable + build_runner). Mặc định manual.
HARNESS_MODEL_STYLE=

# Multi-app: tên cờ chọn app (vd isCustomer). Báo lỗi nếu cờ xuất hiện ngoài lib/app/ và locator.dart. Để trống nếu 1 app.
HARNESS_APP_FLAG=

# Giới hạn dòng cho 1 file Dart (mặc định 500) và cho CLAUDE.md (mặc định 150).
HARNESS_MAX_LINES=
HARNESS_MAX_ENTRY_LINES=
